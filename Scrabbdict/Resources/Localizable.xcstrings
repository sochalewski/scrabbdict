    "analytics_consent.crashes.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Technical crash diagnostics are sent to Firebase Crashlytics so bugs can be fixed, based on a legitimate interest in keeping the app stable."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des diagnostics techniques de plantage sont envoyés à Firebase Crashlytics afin de corriger les bugs, sur la base d'un intérêt légitime à assurer la stabilité de l'app."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Techniczne dane o awariach trafiają do Firebase Crashlytics, aby można było naprawiać błędy. Podstawą jest prawnie uzasadniony interes w utrzymaniu stabilności aplikacji."
          }
        }
      }
    },
    "analytics_consent.crashes.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crash reports are always on"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les rapports de plantage restent actifs"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raporty awarii są zawsze włączone"
          }
        }
      }
    },
    "analytics_consent.deny" : {
