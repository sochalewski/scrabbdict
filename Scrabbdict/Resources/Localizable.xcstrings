    "settings.analytics.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Statistics sent through Google Analytics show which dictionaries, search modes, and app features are used. The words you type are never shared. Crash reports are always sent so bugs can be fixed."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les statistiques envoyées via Google Analytics indiquent quels dictionnaires, modes de recherche et fonctionnalités de l'app sont utilisés. Les mots saisis ne sont jamais partagés. Les rapports de plantage sont toujours envoyés afin de corriger les bugs."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Statystyki przesyłane przez Google Analytics pokazują, jakie słowniki, tryby wyszukiwania i funkcje aplikacji są używane. Wpisywane słowa nigdy nie są udostępniane. Raporty awarii są wysyłane zawsze, aby można było naprawiać błędy."
          }
        }
      }
    },
