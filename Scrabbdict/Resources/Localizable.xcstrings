        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le dictionnaire et le mode de recherche utilisés, le type de recherche, la validité d'un mot vérifié et l'ouverture des Réglages ou de leur lien vers la politique de confidentialité."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Używany słownik i tryb wyszukiwania, rodzaj wyszukiwania, to, czy sprawdzane słowo jest poprawne, oraz otwarcie Ustawień lub zawartego w nich linku do polityki prywatności."
