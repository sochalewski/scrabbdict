    "analytics_consent.shared.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Which dictionary and search mode you use, the type of search, whether a checked word is valid, and when you open Settings or its privacy policy link."
