    "analytics_consent.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can change your choice at any time in Settings."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez modifier votre choix à tout moment dans les Réglages."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swój wybór możesz zmienić w dowolnym momencie w Ustawieniach."
          }
        }
      }
    },
    "analytics_consent.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrabbdict can share usage statistics through Google Analytics. The choice is entirely yours, and the app works the same either way."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrabbdict peut partager des statistiques d'utilisation via Google Analytics. Le choix vous appartient entièrement et l'app fonctionne de la même façon dans les deux cas."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrabbdict może przesyłać statystyki użycia przez Google Analytics. Decyzja należy wyłącznie do Ciebie, a aplikacja działa tak samo niezależnie od wyboru."
          }
        }
      }
    },
    "analytics_consent.never.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your name, contact details, or the words and letters you type. No ads and no tracking across apps or websites."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre nom, vos coordonnées, ni les mots et lettres que vous saisissez. Aucune publicité ni aucun suivi entre apps ou sites web."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoje imię, dane kontaktowe ani wpisywane słowa i litery. Żadnych reklam ani śledzenia między aplikacjami i witrynami."
          }
        }
      }
    },
    "analytics_consent.never.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
